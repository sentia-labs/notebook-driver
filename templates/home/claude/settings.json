{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Read", "Glob", "Grep", "Edit(/vault/**)"],
    "deny": [
      "Edit(/notebook/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/KEY.md)",
      "Edit(/nbd.json)",
      "Edit(/.nbd/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"{{NBD_BIN}}\" hook pre-tool-use", "timeout": 10 }]
      }
    ]
  }
}
